<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Starlight.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2007;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Starlight.Core\Starlight.Core.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Model\Starlight.Model.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Tools.Pc\Starlight.Tools.Pc.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Memory\Starlight.Memory.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Tools.Web\Starlight.Tools.Web.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Tools.Network\Starlight.Tools.Network.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Tools.Code\Starlight.Tools.Code.csproj" />
    <ProjectReference Include="..\..\src\Starlight.Skills\Starlight.Skills.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Starlight.Tools.Desktop\AppMatcher.cs" Link="Linked\AppMatcher.cs" />
    <Compile Include="..\..\src\Starlight.Tools.Desktop\HotkeyParser.cs" Link="Linked\HotkeyParser.cs" />
    <Compile Include="..\..\src\Starlight.Tools.Desktop\TargetParser.cs" Link="Linked\TargetParser.cs" />
    <Compile Include="..\..\src\Starlight.Tools.Desktop\KeyNames.cs" Link="Linked\KeyNames.cs" />
    <Compile Include="..\..\src\Starlight.Eval\EvalCase.cs" Link="Linked\EvalCase.cs" />
    <Compile Include="..\..\src\Starlight.Voice\SpeechText.cs" Link="Linked\SpeechText.cs" />
    <Compile Include="..\..\src\Starlight.Voice\AudioMath.cs" Link="Linked\AudioMath.cs" />
    <Compile Include="..\..\src\Starlight.Voice\WakeTokens.cs" Link="Linked\WakeTokens.cs" />
    <Compile Include="..\..\src\Starlight.Overlay\OverlayGeometry.cs" Link="Linked\OverlayGeometry.cs" />
    <None Include="..\..\src\Starlight.Eval\cases\*.json" Link="cases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fakes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
