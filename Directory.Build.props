<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Authors>Starlight contributors</Authors>
    <Product>Starlight</Product>
    <Copyright>Starlight</Copyright>
    <!-- The recommended analyzer rules are on. Only these stay off, each for a reason:
         CA1716: the "keywords" are Visual Basic ones (Get, Set); this code is C# only.
         CA1711: "Permission" is the word the plan uses for Safe/Ask/Deny. -->
    <NoWarn>$(NoWarn);CA1716;CA1711</NoWarn>
  </PropertyGroup>
</Project>
